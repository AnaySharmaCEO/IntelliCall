# IntelliCall — Environment Configuration Setup

# ==============================================================================
# Supabase Cloud Project Configuration
# ==============================================================================
# Your Supabase Project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Publishable Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_ANON_KEY=eyJhbGciOi...

# Service Role Key (SERVER & EDGE FUNCTIONS ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Database Connection (for direct psql / migrations if using direct connection)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ==============================================================================
# Webhook Secrets
# ==============================================================================
# Secret for verifying incoming voice provider webhooks (Retell / Twilio / Bland / Vapi)
WEBHOOK_SECRET_VOICE=your-voice-webhook-secret-token

# Secret for verifying incoming Calendly appointment booking webhooks
WEBHOOK_SECRET_CALENDLY=your-calendly-webhook-signing-key

# ==============================================================================
# Optional AI / Provider Integrations
# ==============================================================================
# Resonology AI / Google Gemini API key for real-time model analysis
RESONOLOGY_AI_API_KEY=
GEMINI_API_KEY=
